<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulk_badge_wizard_form" model="ir.ui.view">
        <field name="name">bulk.badge.wizard.form</field>
        <field name="model">bulk.badge.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign Badge">
                <group>
                    <field name="action"/>
                    <field name="ribbon_id" invisible="action == 'remove'"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
